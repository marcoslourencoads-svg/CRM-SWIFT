# PostgreSQL
POSTGRES_USER=crm
POSTGRES_PASSWORD=crm_secret
POSTGRES_DB=crm_dev
# Porta 5433: e a que o docker-compose.yml expoe para o host.
DATABASE_URL=postgresql://crm:crm_secret@localhost:5433/crm_dev

# Redis
REDIS_URL=redis://localhost:6379

# API
API_PORT=3333
JWT_SECRET=super-secret-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=super-refresh-secret-change-in-production
JWT_REFRESH_EXPIRES_IN=7d

# CORS (URLs do frontend autorizadas, separadas por vírgula)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3333

# ─── Meta Conversions API (CRM) ───────────────────────────────
# Dataset "LEAD - SWIFT" do portfólio Agencia Swift | Marketing Digital
META_CAPI_ENABLED=false
META_CAPI_DATASET_ID=1046663431035766
META_CAPI_ACCESS_TOKEN=
META_CAPI_API_VERSION=v26.0
META_CAPI_LEAD_EVENT_SOURCE=CRM SWIFT
# Preenchido apenas durante o teste — aparece na aba "Eventos de teste".
# DEIXE VAZIO em produção, senão os eventos não contam de verdade.
META_CAPI_TEST_EVENT_CODE=
